{
  "name": "kava_java_team-3",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=/kava_java_team-3/",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{html,css,js}\" tests playwright.config.js package.json CONTRIBUTING.md .github/workflows/*.yml",
    "format:check": "prettier --check \"src/**/*.{html,css,js}\" tests playwright.config.js package.json CONTRIBUTING.md .github/workflows/*.yml",
    "test": "npm run build && playwright test",
    "check": "npm run format:check && npm test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "glob": "^11.0.0",
    "postcss": "^8.4.41",
    "postcss-sort-media-queries": "^5.2.0",
    "prettier": "3.9.9",
    "vite": "^5.4.6"
  },
  "author": "Alexander Repeta <alexander.repeta@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "modern-normalize": "3.0.1",
    "vite-plugin-full-reload": "^1.2.0",
    "vite-plugin-html-inject": "^1.1.2"
  }
}
